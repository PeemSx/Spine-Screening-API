# Copy this file to .env and adjust values for local development.
# Never commit credentials or patient information.
SPINE_API_ENVIRONMENT=development
SPINE_API_LOG_LEVEL=INFO
SPINE_API_HOST=0.0.0.0
SPINE_API_PORT=8000
SPINE_API_MODEL_PATH=app/weight/best_center_f1.pt
SPINE_API_MODEL_DEVICE=auto
SPINE_API_MAX_UPLOAD_BYTES=20971520
SPINE_API_MAX_IMAGE_PIXELS=50000000
SPINE_API_INFERENCE_CONCURRENCY=1

# Token for the remotely managed Cloudflare Tunnel replica.
TUNNEL_TOKEN=
